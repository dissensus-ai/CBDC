# OS files
.DS_Store
Thumbs.db
desktop.ini

# working-branch artifact: the compiled manuscript is the point
!main.pdf

# confirmatory pilot outputs are regenerated; the summary is committed by hand
detection/confirmatory/results/pilot_replicates.json
detection/confirmatory/results/*.log

# September review candidate: figures and PDF are reviewable outputs.
